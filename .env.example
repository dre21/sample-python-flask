DATABASE_URL=postgresql://user:password@host/dbname
JWT_SECRET_KEY=your-secret-key
FLASK_APP=run.py

# ─── Logging ───────────────────────────────────────────────────────────────────
# FLASK_ENV controls the log level:
#   local       → DEBUG   (your laptop — shows everything)
#   development → INFO    (dev server — shows info, warnings, errors)
#   production  → WARNING (prod server — only warnings and errors)
FLASK_ENV=local

# Optional: override the log level directly (ignores FLASK_ENV mapping)
# LOG_LEVEL=DEBUG
